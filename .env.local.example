# Copia como ".env.local". Usado SOLO por docker-compose.local.yml,
# apunta al contenedor "db" de MySQL local, nunca a tu servidor real.

APP_NAME="Ticketing API (local)"
ENVIRONMENT=development
DEBUG=true

# "db" es el nombre del servicio en docker-compose.local.yml, no localhost,
# porque los contenedores se resuelven por nombre de servicio en la red interna.
DATABASE_URL=mysql+pymysql://ticketing:ticketing@db:3306/ticketing_db?charset=utf8mb4

SECRET_KEY=dev-secret-key-solo-para-local
WEBHOOK_SECRET=dev-webhook-secret-solo-para-local
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Estas son solo documentación/referencia: las credenciales reales del
# contenedor "db" están hardcodeadas en docker-compose.local.yml (para
# evitar bugs de sustitución de variables). Si cambias usuario/password/db
# aquí, cambia TAMBIÉN el bloque "environment" del servicio "db" en
# docker-compose.local.yml para que coincidan.
MYSQL_DATABASE=ticketing_db
MYSQL_USER=ticketing
MYSQL_PASSWORD=ticketing
MYSQL_ROOT_PASSWORD=root_local_only
