# Copia este archivo como ".env" y completa con tus valores reales.
# NUNCA subas el .env real a git.

APP_NAME="Ticketing API"
ENVIRONMENT=development
DEBUG=true

# --- Base de datos: MySQL en tu VM/servidor de Azure ---
# Formato: mysql+pymysql://usuario:password@ip-o-host:3306/nombre_bd?charset=utf8mb4
#
# Ejemplo con tus datos reales (servidor MySQL propio, NO el servicio
# administrado "Azure Database for MySQL" -- ver advertencia de seguridad
# en la guía de despliegue sobre el usuario 'zzz' y el GRANT ALL):
DATABASE_URL=mysql+pymysql://zzz:zzz01@158.23.17.165:3306/ecommerce?charset=utf8mb4

# Si tu MySQL exige conexión cifrada, agrega al final de la URL:
#   &ssl_verify_cert=false
# o revisa la sección de SSL en la guía de despliegue para más detalle.

# --- Seguridad ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Secreto compartido con tu pasarela de pago (Culqi/Niubiz/MercadoPago/Stripe)
# para verificar la firma de los webhooks de confirmación de pago.
WEBHOOK_SECRET=cambia-esto-tambien-por-otra-clave-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
